3. Basic SQL analysis

SELECT * FROM customers;

-- Query 2: Display all products

SELECT * FROM products;
-- Query 3: Find total number of customers

SELECT COUNT(*) AS total_customers
FROM customers;
-- Query 5: Find products with price greater than ₹5,000

SELECT *
FROM products
WHERE price > 5000;

-- Find city-wise customers

SELECT
    city,
    COUNT(*) AS total_customers
FROM customers
GROUP BY city
ORDER BY total_customers DESC;


 
